# NVFP4 deployment contract for this runtime.
# Product checkpoint: nvidia/GLM-5.3-Flash-NVFP4 @ 09b04e5e74bca08ca8549fc736d4cdd8624bfde3
# Quantization: official ModelOpt NVFP4. Dense MLP layers 0-2 and routed experts
# in layers 3-44 store .weight / .weight_scale / .weight_scale_2 / .input_scale.
# Layer 45 experts stay BF16. Attention, router, shared experts, embeddings,
# lm_head and the vision tower stay in their native dtypes.
# Fabric values below are the sanitized dual-Spark baseline. No credentials.

HEAD_IP=192.168.100.10
WORKER_IP=192.168.100.11
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f1
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3

MODEL=nvidia/GLM-5.3-Flash-NVFP4
MODEL_REVISION=09b04e5e74bca08ca8549fc736d4cdd8624bfde3
PORT=8888
SERVED_MODEL_NAME=GLM-5.3-Flash-NVFP4

TP=2
NNODES=2
MASTER_PORT=29521
QUANTIZATION=nvfp4
ENFORCE_EAGER=0

SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2

MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=7168
GPU_MEM_UTIL=0.85
KV_CACHE_DTYPE=fp8
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_ADAPTIVE_K=ema
GLM53_ADAPTIVE_K_SET=2,4,7

USE_HOST_NCCL=0
